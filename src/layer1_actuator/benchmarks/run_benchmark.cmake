if(NOT DEFINED PATH_FILE OR NOT DEFINED ITERATIONS OR NOT DEFINED THREADS)
    message(FATAL_ERROR "PATH_FILE, ITERATIONS, and THREADS are required")
endif()
file(READ "${PATH_FILE}" BENCHMARK_EXECUTABLE)
string(STRIP "${BENCHMARK_EXECUTABLE}" BENCHMARK_EXECUTABLE)
execute_process(COMMAND "${BENCHMARK_EXECUTABLE}" "${ITERATIONS}" "${THREADS}"
    RESULT_VARIABLE BENCHMARK_RESULT)
if(NOT BENCHMARK_RESULT EQUAL 0)
    message(FATAL_ERROR "HPP benchmark failed: ${BENCHMARK_RESULT}")
endif()
